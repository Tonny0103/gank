int linhas;

write("Digite o numero de linhas: ");
read(linhas);

for (int i = 0; i < linhas; i++) {
    int valor = 1;

    for (int espaco = 0; espaco < linhas - i - 1; espaco++) {
        write("  ");

        for (int j = 0; j <= i; j++) {
            write(valor);
            int numerador = valor * (i - j);
            int denominador = j + 1;
            valor = numerador / denominador;
        }

        write("\n");
    }
}
